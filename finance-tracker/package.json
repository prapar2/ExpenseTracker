{
  "name": "finance-tracker",
  "version": "1.0.17",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/server.js",
    "client": "vite client --config client/vite.config.js",
    "build": "vite build client --config client/vite.config.js",
    "start": "node server/server.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dotenv": "^17.3.1",
    "express": "^4.19.2",
    "googleapis": "^131.0.0",
    "multer": "^2.1.0",
    "node-cron": "^3.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.12.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "vite": "^5.3.1"
  }
}
