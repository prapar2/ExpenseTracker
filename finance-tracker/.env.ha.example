# Home Assistant OS Add-on Environment Variables
# Copy these to your Home Assistant add-on config.yaml or set as environment variables

# Google OAuth 2.0 - Required for backups
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-secret-here

# IMPORTANT: This must match your HA instance URL and the OAuth redirect URI registered in Google Cloud Console
# Format: https://your-ha-url/api/hassio_ingress/{token}/app/app-api/auth/google/callback
# The {token} placeholder is automatically replaced by Home Assistant
# If your HA instance is at: https://home.example.com
# Then set this to: https://home.example.com/api/hassio_ingress/{token}/app/app-api/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=https://your-ha-url/api/hassio_ingress/your-addon-slug/app/app-api/auth/google/callback

# Database path (use /data for HA volumes)
DB_PATH=/data/app.db

# Backup credentials storage (use /data for HA writable volume)
BACKUP_CREDENTIALS_PATH=/data/google-oauth.json

# Enable/disable backups
BACKUP_ENABLED=true

# System identifier for backup filenames (helps distinguish between prod/dev/staging)
BACKUP_SYSTEM_NAME=home-assistant

# Backup schedule (cron format, default: Sunday at midnight)
# Sunday at midnight: 0 0 * * 0
# Daily at 2 AM: 0 2 * * *
BACKUP_SCHEDULE=0 0 * * 0

# Server port (Home Assistant controls this, usually 3001)
PORT=3001

# Optional: Force all requests to use HTTPS (useful if HA reverse proxy is HTTPS)
# NODE_ENV=production
