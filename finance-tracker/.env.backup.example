# Finance Tracker Backup Configuration
# Make sure to set these variables in docker-compose.yml or .env file

# Enable automatic backups
BACKUP_ENABLED=true

# Backup schedule in cron format (default: Sunday midnight)
# Format: minute hour day week-day (0=Sunday)
# Examples:
# 0 0 * * 0    = Sunday midnight
# 0 0 * * *    = Daily midnight
# 0 2 * * 0    = Sunday 2 AM
BACKUP_SCHEDULE=0 0 * * 0

# Path to Google OAuth credentials JSON file
# Use OAuth 2.0 credentials (not service account)
# See BACKUP_SETUP.md for setup instructions
BACKUP_CREDENTIALS_PATH=/app/config/google-oauth.json

# System identifier for backup filenames (prod/dev/staging/etc)
# Helps differentiate backups from multiple instances
# Format: prod, dev, staging, test, etc.
BACKUP_SYSTEM_NAME=prod

# Database path (usually doesn't need to change)
DB_PATH=/data/finance.db

# Node environment
NODE_ENV=production
PORT=3001
